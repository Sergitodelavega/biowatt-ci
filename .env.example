# BIOWATT-CI — Environment Variables Example
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT

# Database Connection (PostgreSQL + PostGIS in production, SQLite or Postgres locally)
DATABASE_URL="postgresql://biowatt_user:biowatt_pass@localhost:5432/biowatt_db?schema=public"

# Authentication & Session Secret
JWT_SECRET="super-secret-jwt-key-biowatt-ci-change-in-production"

# Server Port & App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment (development, staging, production)
NODE_ENV="development"
